{
  "name": "lg-video",
  "version": "1.2.0",
  "private": true,
  "description": "LG Video 构建壳（desktop/ 目录为桌面端打包源，android/ 为安卓端工程）",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "electron desktop",
    "build:win": "node scripts/build-win.mjs",
    "pack:win": "electron-builder --dir --x64 -c.directories.output=.build-tmp/win-64"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "electron": "33.4.11",
    "electron-builder": "26.15.7"
  }
}
